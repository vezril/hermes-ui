# ── Hermes UI configuration ───────────────────────────────────────────────────

# Selects the live BFF-backed client. Set to the same-origin BFF base path so the
# browser calls Hermes's own /api/hermes/* routes (never HermesMQ directly). This
# is NOT a secret. Leave unset to run on in-memory fixtures (no HermesMQ needed).
NEXT_PUBLIC_HERMES_API_BASE=/api/hermes

# ── Server-only (the BFF secret boundary — never NEXT_PUBLIC_*) ────────────────

# HermesMQ's REST base URL, reachable from the Next.js server (not the browser).
HERMES_ENDPOINT=http://localhost:8080

# Bearer token with the `admin` scope for HermesMQ's admin API. Server-only; it
# is injected as `Authorization: Bearer` by the BFF and never sent to the client.
HERMES_TOKEN=
